# GSO Data Archive — environment configuration (copy to .env; never commit .env).
# All values below are PLACEHOLDERS.

# --- Database -------------------------------------------------------------
# Collector (read/write). PostgreSQL recommended for production; SQLite works locally.
DATABASE_URL=postgresql://gso_writer:CHANGE_ME@localhost:5432/gso_archive
# Public API (use a READ-ONLY role in production; falls back to DATABASE_URL).
API_DATABASE_URL=postgresql://gso_reader:CHANGE_ME@localhost:5432/gso_archive
# Docker Compose only: password for the bundled postgres container.
POSTGRES_PASSWORD=CHANGE_ME

# --- Source access ---------------------------------------------------------
# Live access to www.gso.org.my is OFF unless this is true. Review GSO's terms of
# use (docs/SOURCE_INVESTIGATION.md §Terms) and obtain consent if required first.
GSO_LIVE_ENABLED=false
GSO_BASE_URL=https://www.gso.org.my
# Comma-separated adapters. solar_profile is unverified: enable only after `probe`.
GSO_ADAPTERS=generation_mix,system_demand,tieline_egat,tieline_hvdc,tieline_pltg,power_station
# Names the project (and no person) to the source operator.
GSO_USER_AGENT=gso-data-archive/2.0 (+https://github.com/Darren38/gso-data-archive)

# --- Scheduling (the ONE place the collection interval is defined for the worker) ---
COLLECT_INTERVAL_SECONDS=300
GSO_REQUEST_DELAY_SECONDS=2
GSO_REQUEST_TIMEOUT_SECONDS=30
GSO_MAX_RETRIES=3
# Re-fetch the previous day at most this often to catch late/revised readings.
GSO_REVISION_RECHECK_MINUTES=60
# Automatically recover missed days up to this many days back, N per cycle.
GSO_AUTO_BACKFILL_DAYS=7
GSO_AUTO_BACKFILL_PER_CYCLE=2

# --- Raw response archive -------------------------------------------------
RAW_STORE_DIR=./data/raw
# all | changed (skip byte-identical repeats) | none
RAW_RETENTION=changed

# --- API ------------------------------------------------------------------
# Origins allowed to call the API from a browser (e.g. your GitHub Pages site).
API_CORS_ORIGINS=https://YOUR-USER.github.io
